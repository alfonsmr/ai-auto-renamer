# Local user configuration & personal preferences (generated by ./install.sh from config.example/)
/config/

# Locally generated macOS Quick Action bundle (contains machine-specific absolute path)
/Smart Rename.workflow/
/Smart Rename & Tag.workflow/
/Rename with Ollama.workflow/

# Python cache, virtual environments & test/typecheck artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.pyright/
.mypy_cache/
.ruff_cache/
.venv/

# macOS Finder metadata
.DS_Store
.AppleDouble
.LSOverride

# Local environment overrides & private material
.env
.env.*
!.env.example
*.local.*
secrets/
private/
.secret
*.key
*.pem
